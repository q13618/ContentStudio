# ===== contentHub docker 部署配置(复制为 .env 后修改) =====
# 对外访问地址(末尾带 /), 渲染产物/图片链接会用它拼 URL; 上服务器后改成 https://你的域名/
CH_PUBLIC_BASE_URL=http://localhost:8080/
CH_HTTP_PORT=8080

# 初始管理员(首次启动自动创建; 之后改这里不会覆盖已存在账号; 纯邮箱登录可留空口令, 见下方 CH_ADMIN_EMAIL)
CH_ADMIN_LOGINID=admin
CH_ADMIN_PASSWD=请改成强口令

# 是否允许自助注册(0=关闭, 仅管理员可建号); 设为 1 时任何邮箱验证通过即自动建号(角色 operator)
CH_ALLOW_REGISTRATION=0

# ===== 邮箱验证码登录(Resend, https://resend.com) =====
# API Key: Resend 控制台 -> API Keys 创建; 留空 = 开发模式, 验证码只打印在 `docker compose logs accountsvc`
RESEND_API_KEY=
# 发件人: 须是在 Resend 验证过的域名; 未验证域名时只能用 onboarding@resend.dev 且只能发给你自己的 Resend 账号邮箱
RESEND_FROM=内容中枢 <login@your-domain.com>
# 管理员邮箱: 首次启动时绑定到上面的管理员账号; 若 CH_ADMIN_PASSWD 留空, 则建一个只能邮箱登录的管理员
CH_ADMIN_EMAIL=
# 这些域名的邮箱首次验证即自动建号(逗号分隔, 如 your-company.com); 其余邮箱需管理员 manage.py invite
CH_EMAIL_ALLOWED_DOMAINS=
# 登录页是否保留「账号口令」入口(false = 纯邮箱验证码登录; 修改后需 docker compose build web)
CH_PASSWORD_LOGIN=true

# MySQL
MYSQL_ROOT_PASSWORD=请改成强口令-root
MYSQL_USER=chuser
MYSQL_PASSWORD=请改成强口令-app

# 凭据加密主密钥(公众号 AppSecret 等加密落库用), 用 `openssl rand -hex 32` 生成
CH_CREDENTIAL_KEY=

# 公众号(可选, 也可在界面「账号」里按账号录入)
CH_WECHAT_APPID=
CH_WECHAT_APPSECRET=

# ===== 构建加速(可选, 阿里云等大陆机房使用; 香港/海外机房留空即可) =====
# APT_MIRROR=http://mirrors.aliyun.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com
# PLAYWRIGHT_DOWNLOAD_HOST=
