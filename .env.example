# ===== contentHub docker 部署配置(复制为 .env 后修改) =====
# 对外访问地址(末尾带 /), 渲染产物/图片链接会用它拼 URL; 上服务器后改成 https://你的域名/
CH_PUBLIC_BASE_URL=http://localhost:8080/
CH_HTTP_PORT=8080

# 初始管理员(首次启动自动创建; 之后改这里不会覆盖已存在账号)
CH_ADMIN_LOGINID=admin
CH_ADMIN_PASSWD=请改成强口令

# 是否允许自助注册(0=关闭, 仅管理员可建号)
CH_ALLOW_REGISTRATION=0

# MySQL
MYSQL_ROOT_PASSWORD=请改成强口令-root
MYSQL_USER=chuser
MYSQL_PASSWORD=请改成强口令-app

# 凭据加密主密钥(公众号 AppSecret 等加密落库用), 用 `openssl rand -hex 32` 生成
CH_CREDENTIAL_KEY=

# 公众号(可选, 也可在界面「账号」里按账号录入)
CH_WECHAT_APPID=
CH_WECHAT_APPSECRET=
